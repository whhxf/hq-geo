{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImageBrief",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "topic_id",
    "title",
    "status",
    "objective",
    "audience",
    "core_thesis",
    "fact_refs",
    "platform",
    "deliverables",
    "prohibited_claims",
    "acceptance_criteria"
  ],
  "properties": {
    "status": {
      "enum": ["draft", "blocked", "ready_for_production", "in_production", "ready_for_review"]
    },
    "fact_refs": {"type": "array", "minItems": 1},
    "deliverables": {"type": "array", "minItems": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "deliverables_items": {
      "type": "object",
      "required": [
        "id",
        "role",
        "size",
        "subject",
        "subject_kind",
        "synthetic",
        "source_assets",
        "status"
      ],
      "properties": {
        "subject_kind": {
          "description": "这张图画的是什么。决定它能不能由模型生成：声称真实存在的东西不能生成。",
          "enum": ["concept", "product_ui", "customer_case", "real_conversation", "real_person"]
        },
        "synthetic": {
          "description": "必须显式写。true = 模型生成，false = 真实素材。缺省视为未声明，校验器会拒。"
        },
        "source_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "rights"],
            "properties": {
              "kind": {"enum": ["real_screenshot", "real_photo", "ai_generated"]}
            }
          }
        },
        "claims_on_image": {
          "description": "图上出现的每一句主张，逐条挂事实。图上写的字和正文一样要能被追问。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "fact_ref"]
          }
        },
        "reference_images": {
          "description": "参考图路径，项目根相对，落在 assets/reference/ 下。参考图大概率不是自己拍的，进项目根就要登记来源与权利。它只用于内部测量与出图条件，不进入任何对外产物。",
          "type": "array",
          "items": {"type": "string"}
        },
        "reference_instruction": {
          "description": "一句话说清参考它的什么。**reference_images 非空时必填**：万相 2.7 的多图参考是生成+编辑模型，不说意图时它可能把参考图当成待编辑对象，你得到的就是「改了一下的参考图」而不是新图。",
          "type": "string",
          "minLength": 1
        },
        "palette_ref": {
          "description": "measure_palette.py 的输出文件路径，项目根相对。指向的那份结果既提供出图的 color_palette 参数，也是站 5 回测时比对的预期色板。",
          "type": "string"
        },
        "status": {"enum": ["planned", "blocked", "generated", "rejected"]}
      }
    }
  }
}
