{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImageBrief",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "topic_id",
    "title",
    "status",
    "objective",
    "audience",
    "core_thesis",
    "fact_refs",
    "platform",
    "deliverables",
    "prohibited_claims",
    "acceptance_criteria"
  ],
  "properties": {
    "status": {
      "enum": ["draft", "blocked", "ready_for_production", "in_production", "ready_for_review"]
    },
    "fact_refs": {"type": "array", "minItems": 1},
    "deliverables": {"type": "array", "minItems": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1},
    "deliverables_items": {
      "type": "object",
      "required": [
        "id",
        "role",
        "size",
        "subject",
        "subject_kind",
        "synthetic",
        "source_assets",
        "status"
      ],
      "properties": {
        "subject_kind": {
          "description": "这张图画的是什么。决定它能不能由模型生成：声称真实存在的东西不能生成。",
          "enum": ["concept", "product_ui", "customer_case", "real_conversation", "real_person"]
        },
        "synthetic": {
          "description": "必须显式写。true = 模型生成，false = 真实素材。缺省视为未声明，校验器会拒。"
        },
        "source_assets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["kind", "path", "rights"],
            "properties": {
              "kind": {"enum": ["real_screenshot", "real_photo", "ai_generated"]}
            }
          }
        },
        "claims_on_image": {
          "description": "图上出现的每一句主张，逐条挂事实。图上写的字和正文一样要能被追问。",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["text", "fact_ref"]
          }
        },
        "status": {"enum": ["planned", "blocked", "generated", "rejected"]}
      }
    }
  }
}
