{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hq-geo.local/contracts/demand-cluster.schema.json",
  "title": "DemandCluster",
  "description": "一次研究归一化后的需求簇。落盘在项目根 research/normalized/<date>-<slug>.clusters.json。它是原始记录的下游——每个代表词都必须能在原始记录里找到。",
  "type": "object",
  "required": [
    "schema_version",
    "core_keyword",
    "produced_at",
    "stage",
    "source_records",
    "clusters",
    "excluded",
    "evidence_ledger"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "core_keyword": { "type": "string", "minLength": 1 },
    "produced_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "stage": {
      "enum": ["keyword_to_keyword", "keyword_to_site", "complete"],
      "description": "研究走到哪一步。keyword_to_keyword=词找词；keyword_to_site=词找站；complete=完整。不写这一项，下游会把半程当全程。"
    },
    "source_records": {
      "type": "array",
      "minItems": 1,
      "description": "这次归一化依据的原始记录文件（相对项目根的路径）。校验器会检查文件真的存在。",
      "items": { "type": "string" }
    },
    "clusters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "cluster_id",
          "priority",
          "name",
          "representative_keywords",
          "clustering_basis",
          "user_task",
          "judgment",
          "evidence_grade",
          "evidence_refs"
        ],
        "properties": {
          "cluster_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "priority": { "enum": ["P0", "P1", "P2"] },
          "name": { "type": "string", "description": "需求簇的名字，用用户任务命名，不用行业黑话。" },
          "representative_keywords": {
            "type": "array",
            "minItems": 1,
            "description": "代表词。每个词都必须能在 source_records 里找到——校验器逐词核对。这一条拦的是「编词」。",
            "items": { "type": "string" }
          },
          "index_range": {
            "type": ["string", "null"],
            "description": "簇级量级——这一簇**加起来**多大，不是单个词多大。一个页面会同时为成百上千个词排名，按单词评估会严重低估机会。同一平台同一指标可以求和；`AGENTS.md` 第 61 行禁止的是跨指标、跨平台加总，不是同指标跨词。evidence_grade 为 inference 的簇必须为空——推断出来的东西没有指数。"
          },
          "competition_and_bid": { "type": ["string", "null"] },
          "user_task": {
            "type": "string",
            "description": "用户在这个簇里要完成什么。这是簇的定义，不是簇的描述。"
          },
          "judgment": { "type": "string", "description": "对这批信号的判断：能不能用、怎么用、风险在哪。" },
          "evidence_grade": {
            "enum": ["direct_platform", "official_aggregate", "proxy", "inference", "unknown"],
            "description": "direct_platform=平台直接返回；official_aggregate=平台官方聚合口径；proxy=代理信号；inference=由需求簇推导；unknown=未知。"
          },
          "evidence_refs": {
            "type": "array",
            "minItems": 1,
            "description": "链回原始记录。没有引用的判断是猜的。",
            "items": { "type": "string" }
          },
          "clustering_basis": {
            "enum": ["surface_norm", "serp_overlap", "task_inference"],
            "description": "这个簇**凭什么**聚出来的。surface_norm=词面变体（大小写、空格，纯规则，可复核）；serp_overlap=搜索结果重叠（可重采复算）；task_inference=人工判断用户任务相同（不可复核，兜底用）。必填——不写依据的簇是猜的。"
          },
          "serp_evidence": {
            "type": ["object", "null"],
            "description": "SERP 采样记录。clustering_basis 为 serp_overlap 时必填。**证据支持或反对都要记**——采到反证却不写，等于只记对自己有利的。写了 serp_overlap 却没有证据，等于声称做了一个没做的测量。",
            "properties": {
              "channels": {
                "type": "array",
                "minItems": 1,
                "description": "在哪些渠道采的样。跨平台一致时可信度更高。",
                "items": { "type": "string" }
              },
              "sampled_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
              "min_jaccard": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "description": "簇内词对的最低 Jaccard。低于阈值（默认 0.15）的必须说明为什么仍然合簇。"
              },
              "note": { "type": "string" }
            }
          },
          "business_potential": {
            "type": ["integer", "null"],
            "minimum": 0,
            "maximum": 3,
            "description": "0–3，来自 Ahrefs。3=我们的产品是这个问题不可替代的解法；2=有帮助但不是必需；1=只能顺带提一句；0=完全没法提。null=还没评。这一项和「量大不大」是两件事，不许合并成总分。"
          }
        }
      }
    },
    "excluded": {
      "type": "array",
      "description": "看过但排除的方向。写清排除理由——排除项是判断的一部分，不是没看见。",
      "items": {
        "type": "object",
        "required": ["what", "why"],
        "properties": {
          "what": { "type": "string" },
          "why": { "type": "string" }
        }
      }
    },
    "inferred_keywords": {
      "type": "array",
      "description": "推断词——由需求簇推导出来、但还没有平台数据支撑的词。必须单独列在这里，不能混进 clusters[].representative_keywords。校验器两边都查。",
      "items": {
        "type": "object",
        "required": ["keyword", "why_inferred", "needs_verification_at"],
        "properties": {
          "keyword": { "type": "string", "minLength": 1 },
          "why_inferred": { "type": "string", "description": "凭什么推出来。写清推导依据。" },
          "needs_verification_at": {
            "type": "array",
            "minItems": 1,
            "description": "要去哪个渠道验证。",
            "items": { "type": "string" }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "description": "决策闸门。各维度独立记录证据等级，不用总分补偿——某一维未知就是未知，不许被其它维的高分盖过去。",
      "additionalProperties": {
        "type": "object",
        "required": ["score", "grade", "note"],
        "properties": {
          "score": { "type": ["integer", "string"], "description": "0–3，未知写字符串「未知」。" },
          "grade": { "enum": ["direct_platform", "official_aggregate", "proxy", "inference", "unknown"] },
          "note": { "type": "string" }
        }
      }
    },
    "evidence_ledger": {
      "type": "array",
      "minItems": 1,
      "description": "证据账本。每条结论必须能回答「哪来的、多硬、什么时候」。",
      "items": {
        "type": "object",
        "required": ["conclusion", "grade", "source", "date"],
        "properties": {
          "conclusion": { "type": "string" },
          "grade": { "enum": ["direct_platform", "official_aggregate", "proxy", "inference", "unknown"] },
          "source": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
        }
      }
    },
    "next_action": {
      "type": ["string", "null"],
      "description": "下一轮唯一动作。写一个，不写清单——写清单等于没定下一步。"
    },
    "success_threshold": { "type": ["string", "null"] },
    "stop_condition": {
      "type": ["string", "null"],
      "description": "什么情况下停止加内容/加投放。没有停止条件的验证会一直加下去。"
    }
  }
}
