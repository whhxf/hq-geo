{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ProductionBrief",
  "type": "object",
  "required": ["schema_version", "id", "topic_id", "title", "status", "objective", "audience", "formats", "core_thesis", "fact_refs", "script", "required_assets", "prohibited_claims", "acceptance_criteria", "handoff"],
  "properties": {
    "status": {"enum": ["draft", "blocked", "ready_for_production", "in_production", "ready_for_review"]},
    "formats": {"type": "array", "minItems": 1},
    "fact_refs": {"type": "array", "minItems": 1},
    "script": {"type": "array", "minItems": 1},
    "required_assets": {"type": "array"},
    "acceptance_criteria": {"type": "array", "minItems": 1}
  }
}

