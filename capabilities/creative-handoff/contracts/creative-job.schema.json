{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hq-content-engine/creative-job.schema.json",
  "title": "CreativeJob",
  "type": "object",
  "required": ["schema_version", "job_id", "revision", "source", "title", "objective", "audience", "target", "strategy", "inputs", "scenes", "constraints", "deliverables", "production_units", "decision_policy", "handoff"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "source": {"type": "object", "required": ["idea_id", "topic_id", "content_id", "production_brief_path"]},
    "title": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "target": {"type": "object", "required": ["platforms", "aspect_ratio", "duration_seconds"]},
    "strategy": {"type": "object", "required": ["mode", "requested_pack_ids"]},
    "inputs": {"type": "object", "required": ["fact_refs", "asset_refs"]},
    "scenes": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "spoken", "visual_intent", "evidence_mode"]}},
    "constraints": {"type": "object", "required": ["prohibited_claims", "synthetic_media_policy"]},
    "deliverables": {"type": "object", "required": ["shared", "channels"], "properties": {"shared": {"type": "array", "minItems": 1}, "channels": {"type": "object", "minProperties": 1}}},
    "production_units": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "type", "count", "phase", "satisfies"]}},
    "decision_policy": {"type": "object", "required": ["required_decisions", "cost_confirmation"]},
    "handoff": {"type": "object", "required": ["target_system", "receipt_schema_path"]}
  },
  "additionalProperties": true
}
