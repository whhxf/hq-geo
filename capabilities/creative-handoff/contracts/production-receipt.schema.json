{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hq-content-engine/production-receipt.schema.json",
  "title": "ProductionReceipt",
  "type": "object",
  "required": ["schema_version", "job_id", "revision", "content_id", "status", "strategy", "project_path", "outputs", "checks", "created_at"],
  "properties": {
    "schema_version": {"const": 1},
    "job_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1},
    "content_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["planned", "generating", "partial", "completed", "blocked", "failed"]},
    "strategy": {"type": "object", "required": ["id", "version"]},
    "project_path": {"type": "string", "minLength": 1},
    "outputs": {"type": "array", "items": {"type": "object", "required": ["id", "type", "path", "sha256", "synthetic", "status"]}},
    "checks": {"type": "object", "required": ["facts", "asset_rights", "platform_spec", "ai_disclosure"]},
    "created_at": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
